# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# Authentication
# JWT secret - must be at least 32 characters
JWT_SECRET=your-secret-key-at-least-32-characters-long

# Signup code - optional, leave empty to allow signups without code
SIGNUP_CODE=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini AI (for email analysis)
GEMINI_API_KEY=your-gemini-api-key

# Akros DB (Supernova) - for Akros products page
AKROS_SUPABASE_URL=https://your-akros-project.supabase.co
AKROS_SUPABASE_SERVICE_KEY=your-akros-service-role-key

# Ryuha Study - Email reminder recipient
RYUHA_REMINDER_EMAIL=your-email@example.com

# Cron job secret (for secure API calls)
CRON_SECRET=your-cron-secret-key

# 토스증권 Open API (OAuth2 client credentials)
TOSS_CLIENT_ID
TOSS_CLIENT_SECRET

# Umami Cloud (웹 트래픽 / 검색 수요 포착)
UMAMI_API_KEY=
UMAMI_WEBSITE_VOICECARDS=
UMAMI_WEBSITE_REVIEWNOTES=
UMAMI_WEBSITE_WILLOW=

# Google Search Console
GOOGLE_SA_JSON_B64=
GSC_PROPERTY_VOICECARDS=sc-domain:voicecards.quest
GSC_PROPERTY_REVIEWNOTES=https://reviewnotes.app/

# CODEF (헥토데이터) 은행 계좌 조회 API
CODEF_SERVICE=demo            # sandbox | demo | api
CODEF_DEMO_CLIENT_ID=
CODEF_DEMO_CLIENT_SECRET=
CODEF_PROD_CLIENT_ID=
CODEF_PROD_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
TENSW_CODEF_CONNECTED_ID=
CODEF_HOMETAX_CERT_DER=
CODEF_HOMETAX_CERT_KEY=
CODEF_HOMETAX_CERT_PASSWORD_ENC=
