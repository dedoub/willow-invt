{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/ui-check-gate.mjs\"",
            "timeout": 30,
            "statusMessage": "UI 검사 통과 기록 확인"
          }
        ]
      }
    ]
  }
}
