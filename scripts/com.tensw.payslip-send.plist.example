<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tensw.payslip-send-2026-09</string>
  <!-- 2026년 9월 급여명세서를 9/23 09:00 에 보낸다. 보낸 뒤 스스로 내려간다.
       Gmail 예약발송은 API 로 만들 수도 고칠 수도 없어서 예약을 여기서 건다. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dongwookkim/scripts/drive-launcher.sh</string>
    <string>/bin/bash</string>
    <string>/Volumes/PRO-G40/app-dev/willow-invt/scripts/tensw-payslip-schedule.sh</string>
    <string>2026-09</string>
    <string>2026-09-23</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Volumes/PRO-G40/app-dev/willow-invt</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Month</key><integer>9</integer>
    <key>Day</key><integer>23</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/dongwookkim/logs/tensw-payslip-send.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dongwookkim/logs/tensw-payslip-send.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/dongwookkim</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
