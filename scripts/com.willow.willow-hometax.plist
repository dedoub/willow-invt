<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.willow.willow-hometax</string>
  <!-- 홈택스는 23:30~06:59 서비스를 닫는다. 새벽 4시 배치에서 국세는 매일 블록페이지만
       받았고 세금계산서 화면도 뜨다 말다 했다(08-29 04:00 타임아웃). 그래서 홈택스는
       4시 턴에서 빼고 서비스가 열린 뒤 여기서만 돈다.
       계산서를 뒤가 쓰는 매칭·자동 분류·아크로스 인보이스 반영도 함께 붙였다 — 4시에 돌면
       하루 묵은 계산서를 보게 된다.
       두 회사가 같은 Chrome 과 같은 포인터를 쓰므로 시간을 겹치지 않게 띄운다.
       텐소 잡에 세금계산서가 붙으면서 07:00 턴이 13분까지 늘어 07:20 과의 간격이
       얇아졌다(08-29 실제 충돌). 40분으로 벌린다 — 겹쳐도 러너의 락이 받아 준다.
       --notify: 하루치 요약은 여기서 한 통만 나간다. 04시 턴이 남긴 실패도 합쳐서. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dongwookkim/scripts/drive-launcher.sh</string>
    <string>/Volumes/PRO-G40/app-dev/willow-invt/scripts/run-local-finance.sh</string>
    <string>willow</string>
    <string>--only</string>
    <string>tax-invoices,national-tax,match,classify,akros</string>
    <string>--notify</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/dongwookkim</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/dongwookkim/logs/willow-local-finance/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dongwookkim/logs/willow-local-finance/launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/dongwookkim</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
